{
  "buildCommand": "",
  "outputDirectory": "public",
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)\\.(css|png|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
