{
  "buildCommand": "",
  "outputDirectory": "public",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)\\.(css|png|svg|webp|jpg|webm|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/brands/ajanta-orpat/",
      "destination": "/brands/ajanta/",
      "permanent": true
    }
  ]
}
